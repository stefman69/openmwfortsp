    /* TSP_WARMDRAIN_V3: set only while a loading screen is draining. */
    std::atomic<bool> gTspWarmDrainFast{ false };

    /* TSP_WARMRATE_V1: each warm draw is an atomic ~240 ms of Mali first-draw
       work - it can be spaced apart but never subdivided, and the program-binary
       and shader-conversion caches already removed everything that WAS divisible.
       So this only chooses how the fixed backlog is distributed. Default is one
       release every 15 frames (~0.5 s apart at 30 fps) instead of V5's four per
       frame, which put the whole backlog into four ~950 ms frames. */
    int tspWarmEnvInt(const char* name, int def)
    {
        const char* tspEnv = std::getenv(name);
        if (tspEnv == nullptr || tspEnv[0] == '\0')
            return def;
        const int tspVal = std::atoi(tspEnv);
        return (tspVal > 0) ? tspVal : def;
    }

    /* TSP_SHADER_WARMDRAW: removes the warm-up drawable once it has been traversed,
       so the extra draw call does not persist for the whole session. */
    class TspWarmupPrune : public osg::NodeCallback
    {
    public:
        /* Runs on the GROUP. Each new program's warm node is added disabled;
           we enable a few per frame so the ~236ms Mali charges per program is
           spread over many frames instead of landing in one 3.4s freeze, and
           retire each node once it has actually been drawn. */
        void operator()(osg::Node* node, osg::NodeVisitor* nv) override
        {
            osg::Group* group = node->asGroup();
            if (group)
            {
                /* TSP_WARMDRAIN_V5: fast mode is armed when a load ends and
                   disarms itself the moment the backlog is gone. */
                if (group->getNumChildren() == 0)
                {
                    if (gTspWarmDrainFast.exchange(false, std::memory_order_relaxed))
                        Log(Debug::Info) << "TSP_WARMDRAIN_V5 backlog cleared";
                }
                int live = 0;
                for (int i = static_cast<int>(group->getNumChildren()) - 1; i >= 0; --i)
                {
                    osg::Node* child = group->getChild(i);
                    int age = 0;
                    child->getUserValue("tspWarmAge", age);
                    if (age < 0)
                    {
                        /* queued but not yet released */
                        continue;
                    }
                    if (age >= 2)
                        group->removeChildren(i, 1);
                    else
                    {
                        child->setUserValue("tspWarmAge", age + 1);
                        ++live;
                    }
                }
                /* Each warm draw is an atomic ~240ms glDrawArrays, so it can only
                   be spaced apart, never subdivided. Wait kCooldownFrames of
                   normal rendering between releases so the hitches scatter
                   across ~15s instead of clustering into one bad stretch. */
                /* TSP_WARMDRAIN_V3: one at a time needs ~3 update passes per
                   program, so 14 queued programs need ~42 passes. That policy
                   is right in gameplay and wrong on a loading screen. */
                const bool tspFast = gTspWarmDrainFast.load(std::memory_order_relaxed);
                /* TSP_WARMGAP_V8: a 15-frame gap turned a 3.4 s lump into ~7 s of
                   a 240 ms hitch every half second, which reads as a long freeze.
                   Any gap short enough to finish quickly IS a stutter storm. So:
                   several per frame while the loading screen is up, and in
                   gameplay at most one every TSP_WARM_GAP_MS - an occasional
                   single blip rather than a stream. */
                static const int tspPerFrame = tspWarmEnvInt("TSP_WARM_PERFRAME", 4);
                static const int tspGapMs = tspWarmEnvInt("TSP_WARM_GAP_MS", 3000);
                const int kPerFrame = tspFast ? tspPerFrame : 1;
                const int kCooldownFrames = 0;
                if (!tspFast)
                {
                    const auto tspNow = std::chrono::steady_clock::now();
                    static auto tspLastRelease = tspNow - std::chrono::milliseconds(60000);
                    if (std::chrono::duration<double, std::milli>(tspNow - tspLastRelease).count()
                        < static_cast<double>(tspGapMs))
                    {
                        traverse(node, nv);
                        return;
                    }
                    tspLastRelease = tspNow;
                }
                if (++mSinceRelease < kCooldownFrames)
                {
                    traverse(node, nv);
                    return;
                }
                int released = 0;
                for (unsigned int i = 0; i < group->getNumChildren() && released < kPerFrame; ++i)
                {
                    osg::Node* child = group->getChild(i);
                    int age = 0;
                    child->getUserValue("tspWarmAge", age);
                    if (age < 0 && (live == 0 || tspFast))
                    {
                        child->setNodeMask(~0u);
                        child->setUserValue("tspWarmAge", 0);
                        ++released;
                        ++live;
                        mSinceRelease = 0;
                    }
                }
            }
            traverse(node, nv);
        }
    private:
        int mSinceRelease = 0;
    };
}

