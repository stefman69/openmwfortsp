+        char after  = *(p + n);
+        if((before==' ') && (after==' ' || after=='\0')) return 1;
+        p += n;
+    }
+    return 0;
+}
+void tsp_late_hardext(void) {
+    static int done=0;
+    if(done) return;
+    done=1;
+    if(!getenv("LIBGL_TSP_LATEDETECT")) return;
+    printf("LIBGL: TSP_LATE running deferred hardware detection\n");
+    {
+        LOAD_GLES2(glGetString);
+        const char* e = gles_glGetString ? (const char*)gles_glGetString(GL_EXTENSIONS) : NULL;
+        if(e) {
+            if(tsp_has(e,"GL_OES_depth24"))               hardext.depth24 = 1;
+            if(tsp_has(e,"GL_OES_packed_depth_stencil"))  hardext.depthstencil = 1;
+            if(tsp_has(e,"GL_OES_standard_derivatives"))  hardext.derivatives = 1;
+            if(tsp_has(e,"GL_OES_depth_texture"))         hardext.depthtex = 1;
+            if(tsp_has(e,"GL_OES_texture_npot"))          hardext.npot = 3;
+            hardext.highp = 1;
+        }
+    }
+    {
+        LOAD_GLES2(glGetString);
+        const char* e = gles_glGetString ? (const char*)gles_glGetString(GL_EXTENSIONS) : NULL;
+        const char* v = gles_glGetString ? (const char*)gles_glGetString(GL_VENDOR) : NULL;
+        const char* r = gles_glGetString ? (const char*)gles_glGetString(GL_RENDERER) : NULL;
+        printf("LIBGL: TSP_EXTDUMP vendor=[%s] renderer=[%s]\n", v?v:"NULL", r?r:"NULL");
+        printf("LIBGL: TSP_EXTDUMP extlen=%d\n", e?(int)strlen(e):-1);
+        if(e) printf("LIBGL: TSP_EXTDUMP ext=[%s]\n", e);
+    }
+    printf("LIBGL: TSP_LATE depth24=%d depthstencil=%d derivatives=%d npot=%d vendor=0x%x highp=%d\n",
+           hardext.depth24, hardext.depthstencil, hardext.derivatives,
+           hardext.npot, hardext.vendor, hardext.highp);
+}
