+static unsigned long tsp_hash(const void* d, long len) {
+    const unsigned char* b=(const unsigned char*)d;
+    unsigned long h=1469598103934665603UL;
+    long step = (len>4096)? (len/512) : 1;
+    if(step<1) step=1;
+    for(long i=0;i<len;i+=step){ h ^= b[i]; h *= 1099511628211UL; }
+    return h;
+}
+static void tsp_vbo_log(const char* what, unsigned int id, long len, const void* data) {
+    static unsigned long n=0;
+    FILE* f=tsp_vbo_f();
+    if(!f) return;
+    if(n>80000) return;
+    fprintf(f,"%lu %s id=%u len=%ld hash=%lu\n", n, what, id, (long)len, data?tsp_hash(data,len):0UL);
+    n++;
+    if((n & 0x1ff)==0) fflush(f);
+}
+
