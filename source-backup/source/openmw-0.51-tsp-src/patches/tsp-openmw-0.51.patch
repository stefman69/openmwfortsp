+            mWorldScene->removeFromPagedRefs(ptr);
+
+            mRendering->rotateObject(ptr, rotate);
+            mPhysics->updateRotation(ptr, rotate);
+
+            if (const auto object = mPhysics->getObject(ptr))
+                updateNavigatorObject(*object);
+        }
