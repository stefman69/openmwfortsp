--- a/apps/openmw/engine.cpp
+++ b/apps/openmw/engine.cpp
@@ -1,4 +1,12 @@
 #include "engine.hpp"
+#include "mwworld/cell.hpp"
+#include "mwworld/cellstore.hpp"
+#include <cstdio>
+#include <components/shader/shadermanager.hpp>
