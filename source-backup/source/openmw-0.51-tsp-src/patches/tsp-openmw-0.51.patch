+    void Actors::updateActor(const MWWorld::Ptr& old, const MWWorld::Ptr& ptr) const
+    {
+        const auto iter = mIndex.find(old.mRef);
+        if (iter != mIndex.end())
+            iter->second->updatePtr(ptr);
+    }
