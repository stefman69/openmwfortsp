+// AVX specific typedefs and functions
+/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+
+typedef __m256 __mw;
+typedef __m256i __mwi;
+
+#define _mmw_set1_ps                _mm256_set1_ps
+#define _mmw_setzero_ps             _mm256_setzero_ps
