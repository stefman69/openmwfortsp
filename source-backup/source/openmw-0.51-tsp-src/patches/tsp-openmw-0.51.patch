+    osg::ref_ptr<osg::Node> SceneManager::cloneErrorMarker()
+    {
+        std::call_once(mErrorMarkerFlag, [this] { mErrorMarker = loadErrorMarker(); });
+
+        return static_cast<osg::Node*>(mErrorMarker->clone(osg::CopyOp::DEEP_COPY_ALL));
+    }
