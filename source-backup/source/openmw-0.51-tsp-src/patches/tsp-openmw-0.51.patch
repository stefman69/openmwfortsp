+    void World::activateDoor(const Ptr& door, MWWorld::DoorState state)
+    {
+        door.getClass().setDoorState(door, state);
+        mDoorStates[door] = state;
+        if (state == MWWorld::DoorState::Idle)
+        {
+            mDoorStates.erase(door);
+            rotateDoor(door, state, 1);
+        }
+    }
