+    mWindowManager = nullptr;
+    mScriptManager = nullptr;
+    mWorld = nullptr;
+    mStereoManager = nullptr;
+    mSoundManager = nullptr;
+    mInputManager = nullptr;
+    mStateManager = nullptr;
