+        : WindowBase("openmw_loading_screen.layout")
+        , mResourceSystem(resourceSystem)
+        , mViewer(viewer)
+        , mTargetFrameRate(120.0)
+        , mLastWallpaperChangeTime(0.0)
+        , mLastRenderTime(0.0)
