+        , mCellLoadingThreshold(1024.f)
+        , mPreloadDistance(Settings::cells().mPreloadDistance)
+        , mPreloadEnabled(Settings::cells().mPreloadEnabled)
+        , mPreloadExteriorGrid(Settings::cells().mPreloadExteriorGrid)
