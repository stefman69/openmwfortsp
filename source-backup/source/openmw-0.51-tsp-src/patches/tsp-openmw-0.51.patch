+    void RenderingManager::setupPlayer(const MWWorld::Ptr& player)
+    {
+        if (!mPlayerNode)
+        {
+            mPlayerNode = new SceneUtil::PositionAttitudeTransform;
+            mPlayerNode->setNodeMask(Mask_Player);
+            mPlayerNode->setName("Player Root");
