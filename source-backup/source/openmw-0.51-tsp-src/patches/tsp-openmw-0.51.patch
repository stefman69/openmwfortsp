+    void RenderingManager::updateProjectionMatrix()
+    {
+        if (mNearClip < 0.0f)
+            throw std::runtime_error("Near clip is less than zero");
+        if (mViewDistance < mNearClip)
+            throw std::runtime_error("Viewing distance is less than near clip");
+
+        const int width = Settings::video().mResolutionX;
+        const int height = Settings::video().mResolutionY;
+
+        const double aspect = (height == 0) ? 1.0 : static_cast<double>(width) / height;
+        const float fov = mFieldOfViewOverridden ? mFieldOfViewOverride : mFieldOfView;
+
+        Log(Debug::Info) << "TSP_DEPTH_PROJECTION_051_V13"
+                         << " near=" << mNearClip
+                         << " far=" << mViewDistance
+                         << " far_near_ratio=" << (mNearClip > 0.f ? mViewDistance / mNearClip : 0.f)
+                         << " fov=" << fov
+                         << " reversed=" << (SceneUtil::AutoDepth::isReversed() ? 1 : 0);
+
+        // TSP_DEPTH_PARTITION_051_V14_ACTIVE
+        const bool tspPartition = tspDepthPartitionEnabled() && !SceneUtil::AutoDepth::isReversed();
+        const float tspFarPassNear = tspWorldNearClip(mNearClip, mViewDistance);
+        const float tspNearPassFar = tspNearPassFarClip(tspFarPassNear, mViewDistance);
+        
+        osg::Matrix unreversedProjectionMatrix
+            = osg::Matrix::perspective(fov, aspect, tspFarPassNear, mViewDistance);
+        
+        Log(Debug::Info) << "TSP_DEPTH_PARTITION_051_V14"
+                         << " enabled=" << (tspPartition ? 1 : 0)
+                         << " configured_near=" << mNearClip
+                         << " far_pass_near=" << tspFarPassNear
+                         << " near_pass_far=" << tspNearPassFar
+                         << " far=" << mViewDistance
+                         << " far_ratio="
+                         << (tspFarPassNear > 0.f ? mViewDistance / tspFarPassNear : 0.f);
+
+
+        osg::Matrix projectionMatrix = SceneUtil::AutoDepth::isReversed()
+            ? SceneUtil::getReversedZProjectionMatrixAsPerspective(fov, aspect, mNearClip, mViewDistance)
+            : unreversedProjectionMatrix;
+
+        if (width != 0 && height != 0)
+        {
+            double offsetX = (mProjectionOffset.x() / width) * 2.0;
+            double offsetY = (mProjectionOffset.y() / height) * 2.0;
+
+            const osg::Matrix translation = osg::Matrix::translate(offsetX, offsetY, 0.0);
+
+            projectionMatrix.postMult(translation);
+            unreversedProjectionMatrix.postMult(translation);
+        }
+
+        // We always set the cameras projection matrix to the un-reversed variant for correct frustum culling.
+        mViewer->getCamera()->setProjectionMatrix(unreversedProjectionMatrix);
+
+        if (tspPartition)
+        {
+            osg::Camera* masterCamera = mViewer->getCamera();
+        
+            if (!sTspNearDepthCamera)
+            {
+                sTspNearDepthCamera = new osg::Camera;
+                sTspNearDepthCamera->setName("TSP V14 near depth partition");
+                sTspNearDepthCamera->setGraphicsContext(masterCamera->getGraphicsContext());
+                sTspNearDepthCamera->setViewport(masterCamera->getViewport());
+                sTspNearDepthCamera->setRenderTargetImplementation(masterCamera->getRenderTargetImplementation());
+                sTspNearDepthCamera->setDrawBuffer(masterCamera->getDrawBuffer());
+                sTspNearDepthCamera->setReadBuffer(masterCamera->getReadBuffer());
+                sTspNearDepthCamera->setClearMask(GL_DEPTH_BUFFER_BIT);
+                sTspNearDepthCamera->setClearDepth(1.0);
+                sTspNearDepthCamera->setComputeNearFarMode(
+                    osg::CullSettings::DO_NOT_COMPUTE_NEAR_FAR);
+                sTspNearDepthCamera->setCullMask(masterCamera->getCullMask());
+                sTspNearDepthCamera->setAllowEventFocus(false);
+                sTspNearDepthCamera->setRenderOrder(osg::Camera::POST_RENDER, 10);
+        
+                mViewer->addSlave(
+                    sTspNearDepthCamera.get(), osg::Matrixd(), osg::Matrixd(), true);
+        
+                Log(Debug::Info)
+                    << "TSP_DEPTH_PARTITION_051_V14 near_camera_created=1";
+            }
+        
+            sTspNearDepthCamera->setGraphicsContext(masterCamera->getGraphicsContext());
+            sTspNearDepthCamera->setViewport(masterCamera->getViewport());
+            sTspNearDepthCamera->setCullMask(masterCamera->getCullMask());
+        
+            const osg::Matrixd tspNearProjection
+                = osg::Matrixd::perspective(fov, aspect, mNearClip, tspNearPassFar);
+            osg::Matrixd tspInverseFar;
+            if (!tspInverseFar.invert(osg::Matrixd(unreversedProjectionMatrix)))
+                Log(Debug::Warning)
+                    << "TSP_DEPTH_PARTITION_051_V14 inverse_far_projection_failed=1";
+            else if (osgViewer::View::Slave* tspSlave
+                = mViewer->findSlaveForCamera(sTspNearDepthCamera.get()))
+            {
+                tspSlave->_projectionOffset = tspInverseFar * tspNearProjection;
+                tspSlave->_viewOffset.makeIdentity();
+                tspSlave->_useMastersSceneData = true;
+            }
+        }
+        else if (sTspNearDepthCamera)
+        {
+            bool tspRemovedNearSlave = false;
+            for (unsigned int tspSlaveIndex = 0;
+                 tspSlaveIndex < mViewer->getNumSlaves();
+                 ++tspSlaveIndex)
+            {
+                if (mViewer->getSlave(tspSlaveIndex)._camera.get()
+                    == sTspNearDepthCamera.get())
+                {
+                    mViewer->removeSlave(tspSlaveIndex);
+                    tspRemovedNearSlave = true;
+                    break;
+                }
+            }
+        
+            Log(Debug::Info)
+                << "TSP_DEPTH_PARTITION_051_V14 near_camera_removed="
+                << (tspRemovedNearSlave ? 1 : 0);
+        
+            sTspNearDepthCamera = nullptr;
+        }
+
+
+        mPerViewUniformStateUpdater->setProjectionMatrix(projectionMatrix);
+
+        mSharedUniformStateUpdater->setNear(mNearClip);
+        mSharedUniformStateUpdater->setFar(mViewDistance);
+
+        if (Stereo::getStereo())
+        {
+            auto res = Stereo::Manager::instance().eyeResolution();
+            setScreenRes(res.x(), res.y());
+            Stereo::Manager::instance().setMasterProjectionMatrix(mPerViewUniformStateUpdater->getProjectionMatrix());
+        }
+        else
+        {
+            setScreenRes(width, height);
+        }
+
+        // Since our fog is not radial yet, we should take FOV in account, otherwise terrain near viewing distance may
+        // disappear. Limit FOV here just for sure, otherwise viewing distance can be too high.
+        float distanceMult = std::cos(osg::DegreesToRadians(std::min(fov, 140.f)) / 2.f);
+        mTerrain->setViewDistance(mViewDistance * (distanceMult ? 1.f / distanceMult : 1.f));
+
+        if (mPostProcessor)
+        {
+            mPostProcessor->getStateUpdater()->setProjectionMatrix(mPerViewUniformStateUpdater->getProjectionMatrix());
+            mPostProcessor->getStateUpdater()->setFov(fov);
+        }
+    }
+
