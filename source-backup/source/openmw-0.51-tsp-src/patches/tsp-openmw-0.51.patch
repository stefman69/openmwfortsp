+    void StatsWindow::onMouseWheel(MyGUI::Widget* /*sender*/, int rel)
+    {
+        if (mSkillView->getViewOffset().top + rel * 0.3 > 0)
+            mSkillView->setViewOffset(MyGUI::IntPoint(0, 0));
+        else
