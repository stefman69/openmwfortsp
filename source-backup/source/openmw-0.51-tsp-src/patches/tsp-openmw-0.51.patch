+                        const auto magicEffect = mStore.get<ESM::MagicEffect>().find(effect.mEffectId);
+                        if (magicEffect->mData.mFlags & ESM::MagicEffect::ContinuousVfx)
+                            MWMechanics::playEffects(ptr, *magicEffect, false);
+                    }
+                }
+            }
+        }
