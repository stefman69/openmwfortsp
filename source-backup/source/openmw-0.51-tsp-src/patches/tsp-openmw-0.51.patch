+    osg::Quat makeInverseNodeRotation(const MWWorld::Ptr& ptr)
+    {
+        const auto& pos = ptr.getRefData().getPosition();
+        return ptr.getClass().isActor() ? makeActorOsgQuat(pos) : makeInversedOrderObjectOsgQuat(pos);
+    }
