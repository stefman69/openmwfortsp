+#define _mmw_andnot_ps              _mm_andnot_ps
+#define _mmw_neg_ps(a)              _mm_xor_ps((a), _mm_set1_ps(-0.0f))
+#define _mmw_abs_ps(a)              _mm_and_ps((a), _mm_castsi128_ps(_mm_set1_epi32(0x7FFFFFFF)))
+#define _mmw_add_ps                 _mm_add_ps
