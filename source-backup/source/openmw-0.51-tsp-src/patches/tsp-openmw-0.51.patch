+        camera->setImplicitBufferAttachmentMask(osg::DisplaySettings::IMPLICIT_COLOR_BUFFER_ATTACHMENT
+            | osg::DisplaySettings::IMPLICIT_DEPTH_BUFFER_ATTACHMENT);
 
