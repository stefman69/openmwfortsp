+    // TSP_ACTUAL_RENDER_RES_PROBE_051_V25
+    class TspActualRenderResolutionProbe final : public osg::Camera::DrawCallback
+    {
+    public:
+        TspActualRenderResolutionProbe(int requestedWidth, int requestedHeight)
+            : mRequestedWidth(requestedWidth)
+            , mRequestedHeight(requestedHeight)
+        {
+        }
+
+        void operator()(osg::RenderInfo& renderInfo) const override
+        {
+            if (mLogged)
+                return;
+
+            GLint glViewport[4] = { -1, -1, -1, -1 };
+            GLint glScissor[4] = { -1, -1, -1, -1 };
+            GLint framebufferBinding = -1;
+
+            glGetIntegerv(GL_VIEWPORT, glViewport);
+            glGetIntegerv(GL_SCISSOR_BOX, glScissor);
+
+#if defined(GL_FRAMEBUFFER_BINDING)
+            glGetIntegerv(GL_FRAMEBUFFER_BINDING, &framebufferBinding);
+#elif defined(GL_FRAMEBUFFER_BINDING_EXT)
+            glGetIntegerv(GL_FRAMEBUFFER_BINDING_EXT, &framebufferBinding);
+#endif
+
+            osg::Camera* camera = renderInfo.getCurrentCamera();
+            osg::Viewport* cameraViewport = camera ? camera->getViewport() : nullptr;
+            osg::GraphicsContext* graphicsContext
+                = camera ? camera->getGraphicsContext() : nullptr;
+            const osg::GraphicsContext::Traits* traits
+                = graphicsContext ? graphicsContext->getTraits() : nullptr;
+
+            const int cameraWidth
+                = cameraViewport ? static_cast<int>(cameraViewport->width()) : -1;
+            const int cameraHeight
+                = cameraViewport ? static_cast<int>(cameraViewport->height()) : -1;
+            const int physicalWidth = traits ? traits->width : -1;
+            const int physicalHeight = traits ? traits->height : -1;
+
+            const char* libglFbo = std::getenv("LIBGL_FBO");
+            const char* libglOutput = std::getenv("LIBGL_TSP_OUTPUT");
+
+            Log(Debug::Info)
+                << "TSP_ACTUAL_RENDER_RES_051_V25"
+                << " requested=" << mRequestedWidth << "x" << mRequestedHeight
+                << " camera_viewport=" << cameraWidth << "x" << cameraHeight
+                << " gl_viewport=" << glViewport[2] << "x" << glViewport[3]
+                << " gl_viewport_xy=" << glViewport[0] << "," << glViewport[1]
+                << " gl_scissor=" << glScissor[2] << "x" << glScissor[3]
+                << " physical_traits=" << physicalWidth << "x" << physicalHeight
+                << " framebuffer_binding=" << framebufferBinding
+                << " LIBGL_FBO=" << (libglFbo ? libglFbo : "<unset>")
+                << " LIBGL_TSP_OUTPUT=" << (libglOutput ? libglOutput : "<unset>");
+
+            mLogged = true;
+        }
+
+    private:
+        int mRequestedWidth;
+        int mRequestedHeight;
+        mutable bool mLogged = false;
+    };
