+        if (physicsActor == nullptr || !actor.isInCell() || actor.getCell()->isExterior())
+            return DetourNavigator::AgentBounds{ Settings::game().mActorCollisionShapeType,
+                Settings::game().mDefaultActorPathfindHalfExtents };
