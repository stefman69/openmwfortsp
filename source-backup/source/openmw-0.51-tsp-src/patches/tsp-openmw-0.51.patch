+            glGetIntegerv(GL_FRAMEBUFFER_BINDING_EXT, &framebufferBinding);
+#endif
+
+            osg::Camera* camera = renderInfo.getCurrentCamera();
+            osg::Viewport* cameraViewport = camera ? camera->getViewport() : nullptr;
+            osg::GraphicsContext* graphicsContext
+                = camera ? camera->getGraphicsContext() : nullptr;
+            const osg::GraphicsContext::Traits* traits
+                = graphicsContext ? graphicsContext->getTraits() : nullptr;
+
+            const int cameraWidth
+                = cameraViewport ? static_cast<int>(cameraViewport->width()) : -1;
+            const int cameraHeight
+                = cameraViewport ? static_cast<int>(cameraViewport->height()) : -1;
+            const int physicalWidth = traits ? traits->width : -1;
+            const int physicalHeight = traits ? traits->height : -1;
+
+            const char* libglFbo = std::getenv("LIBGL_FBO");
