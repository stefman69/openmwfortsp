+			tmpZ = _mmw_blendv_ps(pVtxZ[2], pVtxZ[0], ccwMask);
+			pVtxX[2] = _mmw_blendv_ps(pVtxX[0], pVtxX[2], ccwMask);
+			pVtxY[2] = _mmw_blendv_ps(pVtxY[0], pVtxY[2], ccwMask);
+			pVtxZ[2] = _mmw_blendv_ps(pVtxZ[0], pVtxZ[2], ccwMask);
+			pVtxX[0] = tmpX;
