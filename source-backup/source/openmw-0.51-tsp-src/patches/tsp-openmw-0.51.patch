+        else
+        {
+            const MWWorld::Cell& cellVariant = *cell->getCell();
+            uint32_t ambient = cellVariant.getMood().mAmbiantColor;
+            int ambientTotal = (ambient & 0xff) + ((ambient >> 8) & 0xff) + ((ambient >> 16) & 0xff);
