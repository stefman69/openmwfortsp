<?xml version='1.0' encoding='UTF-8'?>
<MyGUI type="Layout">
    <Widget type="VBox" skin="MW_DialogNoTransp" layer="Modal" position="0 0 760 520" align="Center" name="_Main">
        <Property key="Padding" value="8" />
        <Property key="Spacing" value="10" />

        <Widget type="ComboBox" skin="MW_ComboBox" position="0 0 0 34" name="SelectCharacter">
            <Property key="Caption" value="#{OMWEngine:SelectCharacter}" />
            <UserString key="HStretch" value="true" />
        <Property key="FontHeight" value="24" /></Widget>

        <Widget type="HBox" skin="">
            <UserString key="HStretch" value="true" />
            <UserString key="VStretch" value="true" />
            <Property key="Spacing" value="8" />

            <Widget type="VBox" skin="">

                <UserString key="HStretch" value="true" />
                <UserString key="VStretch" value="true" />
                <Property key="Spacing" value="8" />

                <Widget type="ListBox" skin="MW_List" position="0 0 390 330" name="SaveList">
                    <UserString key="HStretch" value="true" />
                    <UserString key="VStretch" value="true" />
                </Widget>

            </Widget>

            <Widget type="VBox" skin="">
                <UserString key="HStretch" value="false" />
                <UserString key="VStretch" value="true" />
                <Property key="Spacing" value="8" />

                <Widget type="Widget" skin="MW_Box" position="0 0 320 170">
                    <Widget type="ImageBox" skin="ImageBox" position="2 2 316 166" name="Screenshot" />
                </Widget>

                <Widget type="AutoSizedEditBox" skin="NormalText" position="0 0 320 0" name="CellName">
                    <Property key="Static" value="true" />
                    <Property key="MultiLine" value="true" />
                    <Property key="WordWrap" value="true" />
                    <Property key="NeedKey" value="false" />
                    <Property key="TextAlign" value="Center" />
                <Property key="FontHeight" value="22" /></Widget>

                <Widget type="AutoSizedEditBox" skin="SandText" position="0 0 320 0" name="InfoText">
                    <Property key="Static" value="true" />
                    <Property key="MultiLine" value="true" />
                    <Property key="WordWrap" value="true" />
                    <Property key="NeedKey" value="false" />
                <Property key="FontHeight" value="22" /></Widget>
            </Widget>

        </Widget>

        <Widget type="HBox" skin="">
            <Property key="Spacing" value="4" />

            <UserString key="HStretch" value="true" />
            <Widget type="AutoSizedButton" skin="MW_Button" name="DeleteButton">
                <Property key="Caption" value="#{OMWEngine:DeleteGame}" />
            <Property key="FontHeight" value="24" /></Widget>

            <Widget type="EditBox" skin="MW_TextEdit" name="SaveNameEdit">
                <UserString key="HStretch" value="true" />
                <UserString key="VStretch" value="true" />
            <Property key="FontHeight" value="26" /></Widget>

            <Widget type="AutoSizedButton" skin="MW_Button" name="OkButton">
                <Property key="Caption" value="#{Interface:OK}" />
            <Property key="FontHeight" value="24" /></Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" name="CancelButton">
                <Property key="Caption" value="#{Interface:Cancel}" />
            <Property key="FontHeight" value="24" /></Widget>
        </Widget>


    <UserString key="TSPV35_3" value="save-load-760x520-wide-both-columns" /></Widget>
</MyGUI>