+/* TSP_TEXLIFE_V1 ----------------------------------------------------------
+ * Resource-accounting trace for the PowerVR map investigation.
+ * Dormant in normal play. Existing fbo/full diagnostic mode supplies
+ * LIBGL_TSP_FBOPATH, so the trace appears beside fbo.txt as fbo.txt.texlife.
+ */
+static FILE* tsp_texlife_file(void)
+{
+    static int checked = 0;
+    static FILE* f = NULL;
+    static char derived[1024];
+    if (!checked)
+    {
+        checked = 1;
+        const char* path = getenv("LIBGL_TSP_TEXLIFE");
+        if (!path || !path[0])
+        {
+            const char* fbo = getenv("LIBGL_TSP_FBOPATH");
+            if (fbo && fbo[0])
+            {
+                snprintf(derived, sizeof(derived), "%s.texlife", fbo);
+                path = derived;
+            }
+        }
+        if (path && path[0])
+        {
+            f = fopen(path, "w");
+            if (f)
+            {
+                setvbuf(f, NULL, _IOLBF, 0);
+                fprintf(f, "# TSP_TEXLIFE_V1 epoch_ms op fields\n");
+            }
+        }
+    }
+    return f;
+}
+
+static unsigned long tsp_texlife_live = 0;
+static unsigned long tsp_texlife_created_count = 0;
+static unsigned long tsp_texlife_deleted_count = 0;
+static unsigned long tsp_texlife_seq = 0;
+
+static unsigned long long tsp_texlife_epoch_ms(void)
+{
+    struct timeval tv;
+    gettimeofday(&tv, NULL);
+    return (unsigned long long)tv.tv_sec * 1000ULL
+        + (unsigned long long)(tv.tv_usec / 1000);
+}
+
+static unsigned long tsp_texlife_hash_pbo(glbuffer_t* unpack, const GLvoid* data)
+{
+    if (!unpack || !unpack->data || unpack->size <= 0)
+        return 0;
+    uintptr_t off = (uintptr_t)data;
+    if (off >= (uintptr_t)unpack->size)
+        return 0;
+    size_t n = (size_t)unpack->size - (size_t)off;
+    if (n > 4096)
+        n = 4096;
+    const unsigned char* b = (const unsigned char*)unpack->data + off;
+    unsigned long h = 2166136261u;
+    for (size_t i = 0; i < n; ++i)
+        h = (h ^ b[i]) * 16777619u;
+    return h;
+}
+
+static int tsp_texlife_dim(int w, int h)
+{
+    if ((w == 256 && h == 256)
+        || (w == 512 && h == 1024)
+        || (w == 1024 && h == 512))
+        return 1;
+    if (w >= 900 && h >= 800)
+        return 1;
+    return 0;
+}
+
+static void tsp_texlife_printf(const char* fmt, ...)
+{
+    FILE* f = tsp_texlife_file();
+    if (!f)
+        return;
+    fprintf(f, "%llu seq=%lu ", tsp_texlife_epoch_ms(), ++tsp_texlife_seq);
+    va_list ap;
+    va_start(ap, fmt);
+    vfprintf(f, fmt, ap);
+    va_end(ap);
+    fputc('\n', f);
+}
+
+void tsp_texlife_created(gltexture_t* tex)
+{
+    if (!tex)
+        return;
+    ++tsp_texlife_live;
+    ++tsp_texlife_created_count;
+    if (tsp_texlife_created_count <= 16
+        || (tsp_texlife_created_count & 255UL) == 0)
+        tsp_texlife_printf(
+            "SUMMARY cause=create live=%lu created=%lu deleted=%lu id=%u gl=%u",
+            tsp_texlife_live, tsp_texlife_created_count,
+            tsp_texlife_deleted_count, tex->texture, tex->glname);
+}
+
+void tsp_texlife_deleted(gltexture_t* tex)
+{
+    if (!tex)
+        return;
+    if (tex->tsp_life)
+        tsp_texlife_printf(
+            "DELETE live_before=%lu id=%u gl=%u size=%dx%d native=%dx%d "
+            "fmt=0x%x type=0x%x fbo=%d att=0x%x",
+            tsp_texlife_live, tex->texture, tex->glname,
+            tex->width, tex->height, tex->nwidth, tex->nheight,
+            tex->format, tex->type, tex->binded_fbo, tex->binded_attachment);
+    if (tsp_texlife_live)
+        --tsp_texlife_live;
+    ++tsp_texlife_deleted_count;
+    if (tex->tsp_life || (tsp_texlife_deleted_count & 255UL) == 0)
+        tsp_texlife_printf(
+            "SUMMARY cause=delete live=%lu created=%lu deleted=%lu",
+            tsp_texlife_live, tsp_texlife_created_count,
+            tsp_texlife_deleted_count);
+}
+
+void tsp_texlife_image(const char* op, gltexture_t* tex, GLint level,
+                       GLsizei width, GLsizei height, GLenum format, GLenum type,
+                       const GLvoid* data, glbuffer_t* unpack)
+{
+    if (!tex)
+        return;
+    if (level == 0
+        && (unpack || tex->binded_fbo
+            || tsp_texlife_dim(width, height)
+            || tsp_texlife_dim(tex->width, tex->height)))
+        tex->tsp_life = 1;
+    if (!tex->tsp_life && !unpack)
+        return;
+
+    tsp_texlife_printf(
+        "%s id=%u gl=%u level=%d in=%dx%d tex=%dx%d native=%dx%d "
+        "fmt=0x%x type=0x%x src=%p pbo=%u pbo_size=%ld pbo_off=%lu "
+        "pbo_hash=%lu fbo=%d att=0x%x live=%lu",
+        op, tex->texture, tex->glname, level, width, height,
+        tex->width, tex->height, tex->nwidth, tex->nheight,
+        format, type, data,
+        unpack ? unpack->buffer : 0,
+        unpack ? (long)unpack->size : 0L,
+        unpack ? (unsigned long)(uintptr_t)data : 0UL,
+        tsp_texlife_hash_pbo(unpack, data),
+        tex->binded_fbo, tex->binded_attachment, tsp_texlife_live);
+}
+
+void tsp_texlife_attach(const char* op, gltexture_t* tex,
+                        GLuint fbo, GLenum attachment)
+{
+    if (!tex)
+        return;
+    tex->tsp_life = 1;
+    tsp_texlife_printf(
+        "%s id=%u gl=%u fbo=%u att=0x%x size=%dx%d native=%dx%d "
+        "fmt=0x%x type=0x%x live=%lu",
+        op, tex->texture, tex->glname, fbo, attachment,
+        tex->width, tex->height, tex->nwidth, tex->nheight,
+        tex->format, tex->type, tsp_texlife_live);
+}
