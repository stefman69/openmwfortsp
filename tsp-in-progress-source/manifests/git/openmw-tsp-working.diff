+
+        const std::size_t pixels
+            = static_cast<std::size_t>(
+                  width)
+            * static_cast<std::size_t>(
+                  height);
+
+        const std::size_t bytes
+            = pixels * 4;
+
+        if (mTspReadbackBuffer.size()
+            != bytes)
