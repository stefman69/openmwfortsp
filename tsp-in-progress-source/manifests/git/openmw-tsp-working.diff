+
+        const int width
+            = mTspCpuImage->s();
+
+        const int height
+            = mTspCpuImage->t();
+
+        if (width <= 0 || height <= 0)
+        {
+            Log(Debug::Warning)
+                << "TSP_LOCALMAP_PERSIST_V7 "
+                   "CAPTURE_FAIL"
+                << " reason=invalid-size";
+
+            return;
