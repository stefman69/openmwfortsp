+/* TSP_MAP_RTT_READBACK_V1 -------------------------------------------------
+ * Dump a few finished map RTTs straight from the native PowerVR framebuffer
+ * before gl4es unbinds it.  This answers a new question that attachment/status
+ * logging cannot: is the map already corrupt in GPU render-target memory?
+ *
+ * Limited to four 256x256 local-map dumps and three 954x864 world-map dumps.
+ * Completely inert unless LIBGL_TSP_MAP_READBACK_DIR names a directory.
+ */
+const char* volatile tspMapRttReadbackV1Tag = "TSP_MAP_RTT_READBACK_V1";
+static int tsp_map_readback_on(void)
+{
+    static int checked = 0;
+    static int on = 0;
+    if (!checked) {
+        const char* p = getenv("LIBGL_TSP_MAP_READBACK_DIR");
+        on = (p && p[0]);
+        checked = 1;
+    }
+    return on;
+}
+
+static unsigned long long tsp_fnv1a64(
+    const unsigned char* p,
+    size_t n)
+{
+    unsigned long long h = 1469598103934665603ULL;
+    for (size_t i = 0; i < n; ++i) {
+        h ^= (unsigned long long)p[i];
+        h *= 1099511628211ULL;
+    }
+    return h;
+}
+
+static void tsp_map_readback_dump(void)
+{
+    static unsigned int local_n = 0;
+    static unsigned int world_n = 0;
+
+    if (!tsp_map_readback_on())
+        return;
+
+    if (!glstate || !glstate->fbo.fbo_draw)
+        return;
+
+    glframebuffer_t* fb = glstate->fbo.fbo_draw;
+
+    if (!fb || fb->id == 0)
+        return;
+
+    const int w = fb->width;
+    const int h = fb->height;
+    const char* kind = NULL;
+    unsigned int* counter = NULL;
+    unsigned int limit = 0;
+
+    if (w == 256 && h == 256) {
+        kind = "local";
+        counter = &local_n;
+        limit = 4;
+    } else if (w == 954 && h == 864) {
+        kind = "world";
+        counter = &world_n;
+        limit = 3;
+    } else {
+        return;
+    }
+
+    if (*counter >= limit)
+        return;
+
+    const char* dir = getenv("LIBGL_TSP_MAP_READBACK_DIR");
+    if (!dir || !dir[0])
+        return;
+
+    size_t rgba_bytes = (size_t)w * (size_t)h * 4U;
+    unsigned char* rgba = malloc(rgba_bytes);
+
+    if (!rgba) {
+        tsp_texture_diag_log(
+            "MAP_READBACK_ERROR kind=%s fb=%u reason=malloc bytes=%zu",
+            kind,
+            fb->id,
+            rgba_bytes);
+        return;
+    }
+
+    LOAD_GLES(glFinish);
+    LOAD_GLES(glReadPixels);
+
+    if (gles_glFinish)
+        gles_glFinish();
+
+    gles_glReadPixels(
+        0,
+        0,
+        w,
+        h,
+        GL_RGBA,
+        GL_UNSIGNED_BYTE,
+        rgba);
+
+    unsigned long long hash = tsp_fnv1a64(rgba, rgba_bytes);
+    GLuint tex = tsp_fbtrack_get(fb->id);
+    unsigned int index = ++(*counter);
+
+    char path[1024];
+    snprintf(
+        path,
+        sizeof(path),
+        "%s/%s-%02u-fb%u-tex%u-%dx%d.ppm",
+        dir,
+        kind,
+        index,
+        fb->id,
+        tex,
+        w,
+        h);
+
+    FILE* out = fopen(path, "wb");
+
+    if (!out) {
+        tsp_texture_diag_log(
+            "MAP_READBACK_ERROR kind=%s fb=%u tex=%u reason=fopen path=%s hash=%016llx",
+            kind,
+            fb->id,
+            tex,
+            path,
+            hash);
+        free(rgba);
+        return;
+    }
+
+    fprintf(out, "P6\n%d %d\n255\n", w, h);
+
+    unsigned char* rgb = malloc((size_t)w * 3U);
+
+    if (!rgb) {
+        fclose(out);
+        free(rgba);
+        tsp_texture_diag_log(
+            "MAP_READBACK_ERROR kind=%s fb=%u tex=%u reason=rowmalloc",
+            kind,
+            fb->id,
+            tex);
+        return;
+    }
+
+    /* GL's framebuffer origin is bottom-left; write top row first for PPM. */
+    for (int y = h - 1; y >= 0; --y) {
+        const unsigned char* src
+            = rgba + ((size_t)y * (size_t)w * 4U);
+
+        for (int x = 0; x < w; ++x) {
+            rgb[x * 3 + 0] = src[x * 4 + 0];
+            rgb[x * 3 + 1] = src[x * 4 + 1];
+            rgb[x * 3 + 2] = src[x * 4 + 2];
+        }
+
+        fwrite(rgb, 1, (size_t)w * 3U, out);
+    }
+
+    free(rgb);
+    fclose(out);
+
+    size_t center
+        = (((size_t)(h / 2) * (size_t)w)
+            + (size_t)(w / 2)) * 4U;
+
+    tsp_texture_diag_log(
+        "MAP_READBACK kind=%s index=%u fb=%u tex=%u size=%dx%d hash=%016llx center=%u,%u,%u,%u path=%s",
+        kind,
+        index,
+        fb->id,
+        tex,
+        w,
+        h,
+        hash,
+        rgba[center + 0],
+        rgba[center + 1],
+        rgba[center + 2],
+        rgba[center + 3],
+        path);
+
+    free(rgba);
+}
