+/* TSP_PRGCACHE_V1 -----------------------------------------------------------
+   Per-program binary cache, keyed on the CONVERTED GLSL of the attached vertex
+   and fragment shaders. It hooks the single gles_glLinkProgram call inside
+   gl4es_glLinkProgram, so every piece of gl4es bookkeeping around it -
+   accumShaderNeeds, the default vert/frag creation, isShaderCompatible,
+   redoShader, the hasBuiltinAttrib -> glBindAttribLocation pass, fill_program -
+   runs exactly as before. That is the difference from the old LD_PRELOAD SCACHE
+   shim, which returned from its glLinkProgram interposer without ever calling
+   gl4es_glLinkProgram, skipping all of it, and crashed in glDrawElements.
+   Fails closed: a binary the driver refuses is deleted and a real link runs. */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static int tsp_prgcache_on(void) {
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("TSP_PRGCACHE"); v = (e && e[0] == '0') ? 0 : 1; }
+    return v;
+}
+static const char* tsp_prgcache_dir(void) {
+    static const char* d = NULL;
+    if (!d) { const char* e = getenv("TSP_PRGCACHE_DIR"); d = (e && e[0]) ? e : "/mnt/UDISK/tsp_prgcache"; }
+    return d;
+}
+static double tsp_prgcache_ms(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1000000.0;
+}
+static uint64_t tsp_prgcache_fnv(const char* s, uint64_t h) {
+    if (!s) return h;
+    while (*s) { h ^= (unsigned char)(*s++); h *= 1099511628211ULL; }
+    return h;
+}
+static void tsp_prgcache_path(char* out, int n, uint64_t key) {
+    snprintf(out, n, "%s/%016llx.prgbin", tsp_prgcache_dir(), (unsigned long long)key);
+}
+static int tsp_prgcache_load(GLuint id, uint64_t key) {
+    if (hardext.prgbin_n == 0) return 0;
+    char path[512];
+    tsp_prgcache_path(path, sizeof(path), key);
+    FILE* f = fopen(path, "rb");
+    if (!f) return 0;
+    uint32_t magic = 0, fmt = 0, len = 0;
+    if (fread(&magic, 4, 1, f) != 1 || magic != 0x54535031u
+        || fread(&fmt, 4, 1, f) != 1 || fread(&len, 4, 1, f) != 1
+        || len == 0 || len > (32u << 20)) { fclose(f); return 0; }
+    void* buf = malloc(len);
+    if (!buf) { fclose(f); return 0; }
+    size_t got = fread(buf, 1, len, f);
+    fclose(f);
+    if (got != (size_t)len) { free(buf); return 0; }
+    LOAD_GLES_OES(glProgramBinary);
+    LOAD_GLES2(glGetProgramiv);
+    GLint linked = 0;
+    double t0 = tsp_prgcache_ms();
+    gles_glProgramBinary(id, (GLenum)fmt, buf, (GLsizei)len);
+    gles_glGetProgramiv(id, GL_LINK_STATUS, &linked);
+    free(buf);
+    if (!linked) {
+        remove(path);
+        TSP_LOGP("LIBGL: TSP_PRGCACHE reject key=%016llx (deleted, linking instead)\n",
+               (unsigned long long)key);
+        return 0;
+    }
+    TSP_LOGP("LIBGL: TSP_PRGCACHE hit key=%016llx bytes=%u ms=%.1f\n",
+           (unsigned long long)key, (unsigned)len, tsp_prgcache_ms() - t0);
+    return 1;
+}
+static void tsp_prgcache_save(GLuint id, uint64_t key, double link_ms) {
+    if (hardext.prgbin_n == 0) return;
+    LOAD_GLES_OES(glGetProgramBinary);
+    LOAD_GLES2(glGetProgramiv);
+    GLint len = 0;
+    double t0 = tsp_prgcache_ms();
+    gles_glGetProgramiv(id, GL_PROGRAM_BINARY_LENGTH_OES, &len);
+    if (len <= 0) {
+        TSP_LOGP("LIBGL: TSP_PRGCACHE miss key=%016llx link_ms=%.1f save=NO-LENGTH\n",
+               (unsigned long long)key, link_ms);
+        return;
+    }
+    void* buf = malloc(len);
+    if (!buf) return;
+    GLsizei got = 0; GLenum fmt = 0;
+    gles_glGetProgramBinary(id, len, &got, &fmt, buf);
+    if (got > 0) {
+        mkdir(tsp_prgcache_dir(), 0777);
+        char path[512], tmp[560];
+        tsp_prgcache_path(path, sizeof(path), key);
+        snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+        FILE* f = fopen(tmp, "wb");
+        int ok = 0;
+        if (f) {
+            uint32_t magic = 0x54535031u, f32 = (uint32_t)fmt, l32 = (uint32_t)got;
+            ok = (fwrite(&magic, 4, 1, f) == 1) && (fwrite(&f32, 4, 1, f) == 1)
+              && (fwrite(&l32, 4, 1, f) == 1) && (fwrite(buf, 1, got, f) == (size_t)got);
+            fclose(f);
+            if (ok) { if (rename(tmp, path) != 0) ok = 0; } else remove(tmp);
+        }
+        TSP_LOGP("LIBGL: TSP_PRGCACHE miss key=%016llx link_ms=%.1f getbin_ms=%.1f bytes=%d saved=%d\n",
+               (unsigned long long)key, link_ms, tsp_prgcache_ms() - t0, (int)got, ok);
+    } else {
+        TSP_LOGP("LIBGL: TSP_PRGCACHE miss key=%016llx link_ms=%.1f save=GOT0\n",
+               (unsigned long long)key, link_ms);
+    }
+    free(buf);
+}
