+/* TSP_NATIVE_LIFE_DIAG_V1 -------------------------------------------------
+ * Native GLES lifetime accounting. Dormant unless LIBGL_TSP_NATIVE_LIFE=1.
+ * With diagnostics OFF: no files, no sysfs/proc reads, no glGet probes and no
+ * per-draw work. Calls exist only on resource create/delete/storage paths.
+ */
+typedef struct { GLuint id; unsigned long long bytes; int used; } tsp_native_rb_rec_t;
+#define TSP_NATIVE_RB_MAX 2048
+static tsp_native_rb_rec_t tsp_native_rb[TSP_NATIVE_RB_MAX];
+static unsigned long tsp_native_fbo_gen=0, tsp_native_fbo_del=0;
+static unsigned long tsp_native_rb_gen=0, tsp_native_rb_del=0;
+static unsigned long tsp_native_tex_gen=0, tsp_native_tex_del=0;
+static unsigned long long tsp_native_rb_live_bytes=0;
+static unsigned long tsp_native_seq=0;
+
+static int tsp_native_life_on(void) {
+    static int chk=0,on=0;
+    if(!chk){const char*e=getenv("LIBGL_TSP_NATIVE_LIFE");on=(e&&e[0]=='1');chk=1;}
+    return on;
+}
+static FILE* tsp_native_life_file(void) {
+    static int chk=0; static FILE* f=NULL;
+    if(!tsp_native_life_on()) return NULL;
+    if(!chk){
+        const char*p=getenv("LIBGL_TSP_NATIVE_LIFE_PATH"); chk=1;
+        if(p&&p[0]){f=fopen(p,"a");if(f){fprintf(f,"# TSP_NATIVE_LIFE_DIAG_V1 seq event fields\n");fflush(f);}}
+    }
+    return f;
+}
+static void tsp_native_log(const char*fmt,...) {
+    FILE*f=tsp_native_life_file(); if(!f)return;
+    unsigned long seq=__sync_add_and_fetch(&tsp_native_seq,1);
+    fprintf(f,"seq=%lu ",seq);
+    va_list ap;va_start(ap,fmt);vfprintf(f,fmt,ap);va_end(ap);fputc('\n',f);fflush(f);
+}
+static unsigned long long tsp_native_rb_estimate(GLenum fmt,GLsizei w,GLsizei h) {
+    unsigned long long bpp=4;
+    if(fmt==GL_STENCIL_INDEX8)bpp=1;
+    else if(fmt==GL_DEPTH_COMPONENT16||fmt==GL_RGB565_OES||fmt==GL_RGBA4_OES)bpp=2;
+    return (unsigned long long)w*(unsigned long long)h*bpp;
+}
+static tsp_native_rb_rec_t* tsp_native_rb_slot(GLuint id,int create) {
+    tsp_native_rb_rec_t*empty=NULL;if(!id)return NULL;
+    for(int i=0;i<TSP_NATIVE_RB_MAX;i++){
+        if(tsp_native_rb[i].used&&tsp_native_rb[i].id==id)return &tsp_native_rb[i];
+        if(!tsp_native_rb[i].used&&!empty)empty=&tsp_native_rb[i];
+    }
+    if(create&&empty){empty->used=1;empty->id=id;empty->bytes=0;return empty;}
+    return NULL;
+}
+static void tsp_native_fbo_generated(GLuint id){if(!tsp_native_life_on()||!id)return;++tsp_native_fbo_gen;tsp_native_log("GEN_FBO id=%u gen=%lu del=%lu live=%ld",id,tsp_native_fbo_gen,tsp_native_fbo_del,(long)tsp_native_fbo_gen-(long)tsp_native_fbo_del);}
+static void tsp_native_fbo_deleted(GLuint id){if(!tsp_native_life_on()||!id)return;++tsp_native_fbo_del;tsp_native_log("DEL_FBO id=%u gen=%lu del=%lu live=%ld",id,tsp_native_fbo_gen,tsp_native_fbo_del,(long)tsp_native_fbo_gen-(long)tsp_native_fbo_del);}
+static void tsp_native_rb_generated(GLuint id,const char*owner){if(!tsp_native_life_on()||!id)return;++tsp_native_rb_gen;(void)tsp_native_rb_slot(id,1);tsp_native_log("GEN_RB id=%u owner=%s gen=%lu del=%lu live=%ld bytes=%llu",id,owner?owner:"?",tsp_native_rb_gen,tsp_native_rb_del,(long)tsp_native_rb_gen-(long)tsp_native_rb_del,tsp_native_rb_live_bytes);}
+static void tsp_native_rb_deleted(GLuint id,const char*owner){
+    if(!tsp_native_life_on()||!id)return;tsp_native_rb_rec_t*r=tsp_native_rb_slot(id,0);
+    if(r){if(tsp_native_rb_live_bytes>=r->bytes)tsp_native_rb_live_bytes-=r->bytes;else tsp_native_rb_live_bytes=0;r->used=0;r->id=0;r->bytes=0;}
+    ++tsp_native_rb_del;tsp_native_log("DEL_RB id=%u owner=%s gen=%lu del=%lu live=%ld bytes=%llu",id,owner?owner:"?",tsp_native_rb_gen,tsp_native_rb_del,(long)tsp_native_rb_gen-(long)tsp_native_rb_del,tsp_native_rb_live_bytes);
+}
+static void tsp_native_rb_storage(GLuint id,GLenum fmt,GLsizei w,GLsizei h,const char*owner){
+    if(!tsp_native_life_on()||!id)return;tsp_native_rb_rec_t*r=tsp_native_rb_slot(id,1);unsigned long long b=tsp_native_rb_estimate(fmt,w,h);
+    if(r){if(tsp_native_rb_live_bytes>=r->bytes)tsp_native_rb_live_bytes-=r->bytes;else tsp_native_rb_live_bytes=0;r->bytes=b;tsp_native_rb_live_bytes+=b;}
+    tsp_native_log("RB_STORAGE id=%u owner=%s fmt=0x%x size=%dx%d est=%llu live_bytes=%llu",id,owner?owner:"?",fmt,w,h,b,tsp_native_rb_live_bytes);
+}
+/* TSP_NATIVE_TEXTURE_DIAG_V2 ----------------------------------------------
+ * New diagnostic area: exact native GLES texture object + backing-storage
+ * accounting, plus map RTT readback.  Everything in this block is dormant
+ * unless LIBGL_TSP_TEXTURE_DIAG=1.
+ *
+ * Unlike TSP_TEXLIFE_V2 (which follows gl4es wrapper objects), this records
+ * the native GLES names and every glTexImage2D/glCompressedTexImage2D backing
+ * allocation that actually reaches the PowerVR driver.
+ */
+typedef struct {
+    GLuint id;
+    unsigned long long level_bytes[16];
+    unsigned long long total_bytes;
+    int used;
+} tsp_native_tex_v2_t;
+
+static tsp_native_tex_v2_t* tsp_tex_v2 = NULL;
+static size_t tsp_tex_v2_cap = 0;
+static unsigned long tsp_tex_v2_gen = 0;
+static unsigned long tsp_tex_v2_del = 0;
+static unsigned long tsp_tex_v2_storage = 0;
+static unsigned long long tsp_tex_v2_live_bytes = 0;
+static unsigned long tsp_tex_v2_seq = 0;
+
+static int tsp_texture_diag_on(void)
+{
+    static int checked = 0;
+    static int on = 0;
+    if (!checked) {
+        const char* e = getenv("LIBGL_TSP_TEXTURE_DIAG");
+        on = (e && e[0] == '1');
+        checked = 1;
+    }
+    return on;
+}
+
+static FILE* tsp_texture_diag_file(void)
+{
+    static int checked = 0;
+    static FILE* file = NULL;
+    if (!tsp_texture_diag_on())
+        return NULL;
+    if (!checked) {
+        const char* p = getenv("LIBGL_TSP_TEXTURE_DIAG_PATH");
+        checked = 1;
+        if (p && p[0]) {
+            file = fopen(p, "a");
+            if (file) {
+                fprintf(file, "# TSP_NATIVE_TEXTURE_DIAG_V2 seq event fields\n");
+                fflush(file);
+            }
+        }
+    }
+    return file;
+}
+
+static void tsp_texture_diag_log(const char* fmt, ...)
+{
+    FILE* f = tsp_texture_diag_file();
+    if (!f)
+        return;
+    unsigned long seq = __sync_add_and_fetch(&tsp_tex_v2_seq, 1);
+    fprintf(f, "seq=%lu ", seq);
+    va_list ap;
+    va_start(ap, fmt);
+    vfprintf(f, fmt, ap);
+    va_end(ap);
+    fputc('\n', f);
+    fflush(f);
+}
+
+static tsp_native_tex_v2_t* tsp_tex_v2_slot(GLuint id, int create)
+{
+    if (!id)
+        return NULL;
+
+    if ((size_t)id >= tsp_tex_v2_cap) {
+        if (!create)
+            return NULL;
+
+        size_t cap = tsp_tex_v2_cap ? tsp_tex_v2_cap : 1024;
+        while (cap <= (size_t)id)
+            cap *= 2;
+
+        tsp_native_tex_v2_t* n = realloc(
+            tsp_tex_v2,
+            cap * sizeof(tsp_native_tex_v2_t));
+
+        if (!n) {
+            tsp_texture_diag_log(
+                "ERROR table_alloc id=%u requested_cap=%zu",
+                id,
+                cap);
+            return NULL;
+        }
+
+        memset(
+            n + tsp_tex_v2_cap,
+            0,
+            (cap - tsp_tex_v2_cap) * sizeof(tsp_native_tex_v2_t));
+
+        tsp_tex_v2 = n;
+        tsp_tex_v2_cap = cap;
+    }
+
+    tsp_native_tex_v2_t* r = &tsp_tex_v2[id];
+
+    if (create && !r->used) {
+        memset(r, 0, sizeof(*r));
+        r->id = id;
+        r->used = 1;
+    }
+
+    return r->used ? r : NULL;
+}
+
+static unsigned int tsp_texture_channels(GLenum format)
+{
+    switch (format) {
+        case GL_ALPHA:
+        case GL_LUMINANCE:
+        case GL_RED:
+        case GL_DEPTH_COMPONENT:
+            return 1;
+        case GL_LUMINANCE_ALPHA:
+        case GL_RG:
+            return 2;
+        case GL_RGB:
+            return 3;
+        case GL_RGBA:
+        default:
+            return 4;
+    }
+}
+
+static unsigned long long tsp_texture_estimate(
+    GLsizei width,
+    GLsizei height,
+    GLenum format,
+    GLenum type)
+{
+    if (width <= 0 || height <= 0)
+        return 0;
+
+    unsigned long long bpp;
+
+    switch (type) {
+        case GL_UNSIGNED_SHORT_5_6_5:
+        case GL_UNSIGNED_SHORT_4_4_4_4:
+        case GL_UNSIGNED_SHORT_5_5_5_1:
+            bpp = 2;
+            break;
+        case GL_HALF_FLOAT_OES:
+        case GL_HALF_FLOAT:
+            bpp = 2ULL * tsp_texture_channels(format);
+            break;
+        case GL_FLOAT:
+            bpp = 4ULL * tsp_texture_channels(format);
+            break;
+        case GL_UNSIGNED_SHORT:
+        case GL_SHORT:
+            bpp = 2ULL * tsp_texture_channels(format);
+            break;
+        case GL_UNSIGNED_INT:
+        case GL_INT:
+            bpp = 4ULL * tsp_texture_channels(format);
+            break;
+        case GL_UNSIGNED_BYTE:
+        case GL_BYTE:
+        default:
+            bpp = tsp_texture_channels(format);
+            break;
+    }
+
+    return (unsigned long long)width
+        * (unsigned long long)height
+        * bpp;
+}
+
+void tsp_native_texture_generated_v2(GLuint id, const char* owner)
+{
+    if (!tsp_texture_diag_on() || !id)
+        return;
+
+    tsp_native_tex_v2_t* r = tsp_tex_v2_slot(id, 1);
+    int reused = (r && r->total_bytes != 0);
+
+    ++tsp_tex_v2_gen;
+
+    tsp_texture_diag_log(
+        "GEN_TEX id=%u owner=%s gen=%lu del=%lu live=%ld tracked_bytes=%llu reused=%d",
+        id,
+        owner ? owner : "?",
+        tsp_tex_v2_gen,
+        tsp_tex_v2_del,
+        (long)tsp_tex_v2_gen - (long)tsp_tex_v2_del,
+        tsp_tex_v2_live_bytes,
+        reused);
+}
+
+void tsp_native_texture_deleted_v2(GLuint id, const char* owner)
+{
+    if (!tsp_texture_diag_on() || !id)
+        return;
+
+    tsp_native_tex_v2_t* r = tsp_tex_v2_slot(id, 0);
+    unsigned long long released = 0;
+    int tracked = 0;
+
+    if (r) {
+        released = r->total_bytes;
+        tracked = 1;
+
+        if (tsp_tex_v2_live_bytes >= released)
+            tsp_tex_v2_live_bytes -= released;
+        else
+            tsp_tex_v2_live_bytes = 0;
+
+        memset(r, 0, sizeof(*r));
+    }
+
+    ++tsp_tex_v2_del;
+
+    tsp_texture_diag_log(
+        "DEL_TEX id=%u owner=%s tracked=%d released=%llu gen=%lu del=%lu live=%ld live_bytes=%llu",
+        id,
+        owner ? owner : "?",
+        tracked,
+        released,
+        tsp_tex_v2_gen,
+        tsp_tex_v2_del,
+        (long)tsp_tex_v2_gen - (long)tsp_tex_v2_del,
+        tsp_tex_v2_live_bytes);
+}
+
+void tsp_native_texture_storage_v2(
+    GLuint id,
+    GLint level,
+    GLsizei width,
+    GLsizei height,
+    GLenum internalformat,
+    GLenum format,
+    GLenum type,
+    unsigned long long explicit_bytes,
+    const char* owner)
+{
+    if (!tsp_texture_diag_on())
+        return;
+
+    unsigned long long bytes = explicit_bytes
+        ? explicit_bytes
+        : tsp_texture_estimate(width, height, format, type);
+
+    tsp_native_tex_v2_t* r = tsp_tex_v2_slot(id, id != 0);
+    unsigned long long old = 0;
+
+    if (r && level >= 0 && level < 16) {
+        old = r->level_bytes[level];
+
+        if (r->total_bytes >= old)
+            r->total_bytes -= old;
+        else
+            r->total_bytes = 0;
+
+        if (tsp_tex_v2_live_bytes >= old)
+            tsp_tex_v2_live_bytes -= old;
+        else
+            tsp_tex_v2_live_bytes = 0;
+
+        r->level_bytes[level] = bytes;
+        r->total_bytes += bytes;
+        tsp_tex_v2_live_bytes += bytes;
+    }
+
+    ++tsp_tex_v2_storage;
+
+    tsp_texture_diag_log(
+        "TEX_STORAGE id=%u owner=%s level=%d size=%dx%d ifmt=0x%x fmt=0x%x type=0x%x bytes=%llu old=%llu realloc=%d tex_bytes=%llu live_bytes=%llu calls=%lu",
+        id,
+        owner ? owner : "?",
+        level,
+        width,
+        height,
+        internalformat,
+        format,
+        type,
+        bytes,
+        old,
+        old != 0,
+        r ? r->total_bytes : 0,
+        tsp_tex_v2_live_bytes,
+        tsp_tex_v2_storage);
+}
+
+/* Wrap the exact GLES allocation boundary.  The extra glGetIntegerv exists
+ * only while diagnostics are armed; with them off this is a straight-through
+ * call to the driver.
+ */
+void tsp_native_gles_teximage2d_v2(
+    GLenum target,
+    GLint level,
+    GLint internalformat,
+    GLsizei width,
+    GLsizei height,
+    GLint border,
+    GLenum format,
+    GLenum type,
+    const GLvoid* data)
+{
+    GLuint id = 0;
+
+    LOAD_GLES(glTexImage2D);
+
+    if (tsp_texture_diag_on() && target == GL_TEXTURE_2D) {
+        LOAD_GLES(glGetIntegerv);
+        if (gles_glGetIntegerv) {
+            GLint bound = 0;
+            gles_glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+            if (bound > 0)
+                id = (GLuint)bound;
+        }
+    }
+
+    gles_glTexImage2D(
+        target,
+        level,
+        internalformat,
+        width,
+        height,
+        border,
+        format,
+        type,
+        data);
+
+    if (tsp_texture_diag_on()) {
+        tsp_native_texture_storage_v2(
+            id,
+            level,
+            width,
+            height,
+            internalformat,
+            format,
+            type,
+            0,
+            "glTexImage2D");
+    }
+}
+
+void tsp_native_gles_compressed_teximage2d_v2(
+    GLenum target,
+    GLint level,
+    GLenum internalformat,
+    GLsizei width,
+    GLsizei height,
+    GLint border,
+    GLsizei imageSize,
+    const GLvoid* data)
+{
+    GLuint id = 0;
+
+    LOAD_GLES(glCompressedTexImage2D);
+
+    if (tsp_texture_diag_on() && target == GL_TEXTURE_2D) {
+        LOAD_GLES(glGetIntegerv);
+        if (gles_glGetIntegerv) {
+            GLint bound = 0;
+            gles_glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+            if (bound > 0)
+                id = (GLuint)bound;
+        }
+    }
+
+    gles_glCompressedTexImage2D(
+        target,
+        level,
+        internalformat,
+        width,
+        height,
+        border,
+        imageSize,
+        data);
+
+    if (tsp_texture_diag_on()) {
+        tsp_native_texture_storage_v2(
+            id,
+            level,
+            width,
+            height,
+            internalformat,
+            internalformat,
+            GL_UNSIGNED_BYTE,
+            (unsigned long long)((imageSize > 0) ? imageSize : 0),
+            "glCompressedTexImage2D");
+    }
+}
+
+/* Keep V1 FBO/RB diagnostics useful, but feed the new native-texture tracker
+ * from the same exact object boundary.
+ */
+void tsp_native_life_texture_generated(GLuint id)
+{
+    if (id && tsp_native_life_on()) {
+        ++tsp_native_tex_gen;
+        tsp_native_log(
+            "GEN_TEX gl=%u gen=%lu del=%lu live=%ld",
+            id,
+            tsp_native_tex_gen,
+            tsp_native_tex_del,
+            (long)tsp_native_tex_gen - (long)tsp_native_tex_del);
+    }
+
+    tsp_native_texture_generated_v2(id, "native-gen");
+}
+
+void tsp_native_life_texture_deleted(GLuint id)
+{
+    if (id && tsp_native_life_on()) {
+        ++tsp_native_tex_del;
+        tsp_native_log(
+            "DEL_TEX gl=%u gen=%lu del=%lu live=%ld",
+            id,
+            tsp_native_tex_gen,
+            tsp_native_tex_del,
+            (long)tsp_native_tex_gen - (long)tsp_native_tex_del);
+    }
+
+    tsp_native_texture_deleted_v2(id, "native-delete");
+}
+
+/* TSP_PVR_RB_LIFETIME_FIX_V1
+ * gl4es proxy depth/stencil renderbuffers belonged to a texture. Old
+ * glDeleteFramebuffers() zeroed renderdepth/renderstencil before deleting the
+ * native RB, making the later texture destructor unable to free it.
+ */
+static void tsp_pvr_delete_proxy_rb(GLuint*id,const char*owner){
+    if(!id||!*id)return;GLuint doomed=*id;*id=0;tsp_native_rb_deleted(doomed,owner);gl4es_glDeleteRenderbuffers(1,&doomed);
+}
