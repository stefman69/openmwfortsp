+static void tsp_shcache_save(uint64_t key, const shaderconv_need_t* need, const char* txt) {
+    if (!txt) return;
+    size_t len = strlen(txt);
+    if (!len) return;
+    mkdir(tsp_shcache_dir(), 0777);
+    char path[512], tmp[560];
+    tsp_shcache_path(path, sizeof(path), key);
+    snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+    FILE* f = fopen(tmp, "wb");
+    if (!f) return;
+    uint32_t magic = TSP_SHCACHE_MAGIC, nb = (uint32_t)sizeof(shaderconv_need_t), l32 = (uint32_t)len;
+    int ok = (fwrite(&magic,4,1,f)==1) && (fwrite(&nb,4,1,f)==1) && (fwrite(&l32,4,1,f)==1)
