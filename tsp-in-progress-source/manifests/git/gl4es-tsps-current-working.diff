     if(gles_glLinkProgram) {
         LOAD_GLES(glGetError);
         LOAD_GLES2(glGetProgramiv);
-        gles_glLinkProgram(glprogram->id);
+
+        /* TSP_PRGCACHE_V1: the ONLY line that changes. Everything gl4es does
+           before and after this point is untouched. */
+        {
+            uint64_t tspKey = 0;
+            if (tsp_prgcache_on() && glprogram->last_vert && glprogram->last_frag) {
+                tspKey = tsp_prgcache_fnv(glprogram->last_vert->converted, 1469598103934665603ULL);
+                tspKey = tsp_prgcache_fnv(glprogram->last_frag->converted, tspKey);
+            }
+            if (!(tspKey && tsp_prgcache_load(glprogram->id, tspKey))) {
+                double tspT0 = tsp_prgcache_ms();
+                gles_glLinkProgram(glprogram->id);
+                if (tspKey) tsp_prgcache_save(glprogram->id, tspKey, tsp_prgcache_ms() - tspT0);
+            }
+        }
         GLenum err = gles_glGetError();
         // Get Link Status
         gles_glGetProgramiv(glprogram->id, GL_LINK_STATUS, &glprogram->linked);
