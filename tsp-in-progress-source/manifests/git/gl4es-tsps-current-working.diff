+/* TSP_SHCACHE_V1 -------------------------------------------------------------
+   ConvertShader + the two TSP rewrites cost ~19 ms per shader of pure CPU and
+   are a deterministic function of the raw source, so the result is cacheable.
+   The program-binary cache removes the ~50 ms link; this removes the larger
+   remaining half (~38 ms per program pair).
+
+   CRITICAL: ConvertShader also FILLS glshader->need, which gl4es_glLinkProgram
+   reads back via accumShaderNeeds. Caching only the text would leave need
+   zeroed - the same class of mistake that made the old LD_PRELOAD SCACHE crash
+   in glDrawElements. So the file carries the shaderconv_need_t bytes too, with
+   sizeof in the header so a struct layout change invalidates rather than
+   corrupts. Fails closed: any bad read just converts normally. */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define TSP_SHCACHE_MAGIC 0x54534332u
+
+static int tsp_shcache_on(void) {
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("TSP_SHCACHE"); v = (e && e[0] == '0') ? 0 : 1; }
+    return v;
+}
+static const char* tsp_shcache_dir(void) {
+    static const char* d = NULL;
+    if (!d) { const char* e = getenv("TSP_SHCACHE_DIR"); d = (e && e[0]) ? e : "/mnt/UDISK/tsp_shcache"; }
+    return d;
+}
+static double tsp_shcache_ms(void) {
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1000000.0;
+}
+static uint64_t tsp_shcache_fnv(const char* s, uint64_t h) {
+    if (!s) return h;
+    while (*s) { h ^= (unsigned char)(*s++); h *= 1099511628211ULL; }
+    return h;
+}
+static void tsp_shcache_path(char* out, int n, uint64_t key) {
+    snprintf(out, n, "%s/%016llx.shconv", tsp_shcache_dir(), (unsigned long long)key);
+}
+static char* tsp_shcache_load(uint64_t key, shaderconv_need_t* need) {
+    char path[512]; tsp_shcache_path(path, sizeof(path), key);
+    FILE* f = fopen(path, "rb");
+    if (!f) return NULL;
+    uint32_t magic = 0, nb = 0, len = 0;
+    if (fread(&magic,4,1,f)!=1 || magic!=TSP_SHCACHE_MAGIC
+        || fread(&nb,4,1,f)!=1 || nb!=(uint32_t)sizeof(shaderconv_need_t)
+        || fread(&len,4,1,f)!=1 || len==0 || len>(8u<<20)) { fclose(f); return NULL; }
+    shaderconv_need_t tmp;
+    if (fread(&tmp, 1, nb, f) != nb) { fclose(f); return NULL; }
+    char* txt = (char*)malloc(len + 1);
+    if (!txt) { fclose(f); return NULL; }
+    size_t got = fread(txt, 1, len, f);
+    fclose(f);
+    if (got != (size_t)len) { free(txt); return NULL; }
+    txt[len] = 0;
+    if (need) memcpy(need, &tmp, nb);
+    return txt;
+}
+static void tsp_shcache_save(uint64_t key, const shaderconv_need_t* need, const char* txt) {
+    if (!txt) return;
+    size_t len = strlen(txt);
+    if (!len) return;
+    mkdir(tsp_shcache_dir(), 0777);
+    char path[512], tmp[560];
+    tsp_shcache_path(path, sizeof(path), key);
+    snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+    FILE* f = fopen(tmp, "wb");
+    if (!f) return;
+    uint32_t magic = TSP_SHCACHE_MAGIC, nb = (uint32_t)sizeof(shaderconv_need_t), l32 = (uint32_t)len;
+    int ok = (fwrite(&magic,4,1,f)==1) && (fwrite(&nb,4,1,f)==1) && (fwrite(&l32,4,1,f)==1)
+          && (fwrite(need,1,nb,f)==nb) && (fwrite(txt,1,len,f)==len);
+    fclose(f);
+    if (ok) { if (rename(tmp, path) != 0) remove(tmp); } else remove(tmp);
+}
+/* sets glshader->converted and glshader->need, from cache or by converting */
+static void tsp_shconv_cached(struct shader_s* glshader) {
+    const int tspVert = (glshader->type == GL_VERTEX_SHADER) ? 1 : 0;
+    uint64_t key = 0;
+    if (tsp_shcache_on() && glshader->source) {
+        key = tsp_shcache_fnv(glshader->source, 1469598103934665603ULL);
+        key = tsp_shcache_fnv(tspVert ? "V" : "F", key);
+        double t0 = tsp_shcache_ms();
+        char* cached = tsp_shcache_load(key, &glshader->need);
+        if (cached) {
+            glshader->converted = cached;
+            TSP_LOGP("LIBGL: TSP_SHCACHE hit key=%016llx vert=%d bytes=%u ms=%.1f\n",
+                   (unsigned long long)key, tspVert, (unsigned)strlen(cached),
+                   tsp_shcache_ms() - t0);
+            return;
+        }
+    }
+    double t1 = tsp_shcache_ms();
+    glshader->converted = tsp_invariant_pos(tsp_highp_varyings(ConvertShader(glshader->source, tspVert, &glshader->need)), tspVert);
+    double conv_ms = tsp_shcache_ms() - t1;
+    if (key) {
+        tsp_shcache_save(key, &glshader->need, glshader->converted);
+        TSP_LOGP("LIBGL: TSP_SHCACHE miss key=%016llx vert=%d conv_ms=%.1f bytes=%u\n",
+               (unsigned long long)key, tspVert, conv_ms,
+               glshader->converted ? (unsigned)strlen(glshader->converted) : 0u);
+    }
+}
