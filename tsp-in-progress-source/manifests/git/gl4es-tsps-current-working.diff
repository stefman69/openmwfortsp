+            tsp_shconv_cached(glshader); /* TSP_SHCACHE_V1 */
             tsp_shader_report("convert", shader, glshader->type==GL_VERTEX_SHADER, glshader->source, glshader->converted);
         // send source to GLES2 hardware if any
