+        if(target==GL_ARRAY_BUFFER && (buff->usage==GL_DYNAMIC_DRAW || buff->usage==GL_STREAM_DRAW) && tsp_orphan_on()) {   /* TSP_VBO_ORPHAN_V5 */
+            memcpy((char*)buff->data + offset, data, size);   /* shadow first: the fresh name is filled from it */
+            if(tsp_orphan_rotate(buff, target)) {
+                tsp_orphan_report(size, 0);
+                noerrorShim();
+                return;
+            }
+            tsp_orphan_report(size, 1);   /* could not rotate: fall through to the stock SubData below */
+        }
         LOAD_GLES(glBufferSubData);
         LOAD_GLES(glBindBuffer);
         bindBuffer(target, buff->real_buffer);
