/* TSP_LOADGATE_V7 */
static int tspLoadEnvInt(const char* name, int def)
{
    const char* tspEnv = std::getenv(name);
    if (tspEnv == nullptr || tspEnv[0] == '\0')
        return def;
    const int tspVal = std::atoi(tspEnv);
    return (tspVal > 0) ? tspVal : def;
}

